# ============================================================
# Данные (тяжелые) — не коммитим
# ============================================================
data/
stage1/
*.zip
*.tar.gz
*.tar
*.7z
*.rar

# ============================================================
# Содержимое папок игнорируем, но структуру (.gitkeep) оставляем
# ============================================================
checkpoints/*
!checkpoints/.gitkeep

predictions/*
!predictions/.gitkeep

results/logs/*
!results/logs/.gitkeep

results/plots/*
!results/plots/.gitkeep

submission/*
!submission/.gitkeep

# ============================================================
# Изображения — не коммитим (кроме явно нужных мест)
# ============================================================
# Любые картинки — игнорируем по умолчанию
*.png
*.jpg
*.jpeg
*.bmp
*.tif
*.tiff
*.webp
*.gif
*.svg

# Но в results/plots/ графики нужны — они мелкие и полезные
!results/plots/*.png
!results/plots/*.jpg
!results/plots/*.svg

# И в docs/ если будешь делать документацию с картинками
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.svg

# ============================================================
# Кэш Python и Jupyter
# ============================================================
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
*.ipynb_checkpoints

# ============================================================
# Виртуальные окружения
# ============================================================
.venv/
venv/
env/
ENV/
.python-version

# ============================================================
# Логи и временные файлы
# ============================================================
*.log
*.tmp
*.temp
*.bak
*.swp
*~

# ============================================================
# Локальные конфиги
# ============================================================
.env
.env.local
config_local.yaml

# ============================================================
# IDE (VS Code и JetBrains)
# ============================================================
.vscode/
.idea/
*.iml
*.ipr
*.iws
*.sublime-project
*.sublime-workspace

# ============================================================
# Системные файлы ОС
# ============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ============================================================
# ML-специфичное
# ============================================================
# Веса моделей — большие, не коммитим
*.pth
*.pt
*.ckpt
*.h5
*.onnx
*.pb

# Но конфиг обучения — маленький и нужный
!checkpoints/config_train.json
!configs/*.yaml

# TensorBoard / WandB логи
runs/
wandb/
lightning_logs/

# Данные в разных форматах
*.csv
*.parquet
*.feather
*.npy
*.npz
*.pkl
*.pickle

# Но маленькие CSV с метриками — оставляем
!results/metrics.csv
!submission/submission.csv
!configs/*.csv
!predict.md